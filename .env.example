# Every variable is optional. Each is shown with the value the application uses
# when the variable is absent.

# Without APP_PASSWORD the login password is 123456. Any non-empty value is
# accepted here exactly as written, with no length or strength check. Changing
# it invalidates existing sessions.
#APP_PASSWORD=123456

# Container images default to /app/data. A plain binary defaults to the
# platform user data directory:
#   Linux/BSD  $XDG_DATA_HOME/bookshelf, else ~/.local/share/bookshelf
#   macOS      ~/Library/Application Support/bookshelf
#   Windows    %LOCALAPPDATA%\bookshelf
#DATA_DIR=

#PORT=8070
#MAX_UPLOAD_MB=400
#SESSION_DAYS=90
#TRUST_PROXY=false
#LOG_LEVEL=info
